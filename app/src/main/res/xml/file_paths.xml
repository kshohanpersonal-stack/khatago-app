<?xml version="1.0" encoding="utf-8"?>
<!-- The only area ever shared out: attachments, so the system image viewer can open a receipt the user
     just tapped. Exports are not here on purpose — a CSV or backup is written straight to wherever the user
     chose in the system picker (SAF), so there is no app-side copy that a content URI could leak. -->
<paths>
    <files-path name="attachments" path="attachments/" />
</paths>
